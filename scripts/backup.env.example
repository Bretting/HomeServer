# Copy to scripts/backup.env and `chmod 600 scripts/backup.env` (has secrets).

# Where restic stores backups. Pick ONE and uncomment.
#  - Local external drive (simplest):
RESTIC_REPOSITORY=/mnt/backup/restic-homeserver
#  - Backblaze B2 (off-site, cheap):
# RESTIC_REPOSITORY=b2:your-bucket-name:homeserver
# B2_ACCOUNT_ID=xxxxxxxxxxxx
# B2_ACCOUNT_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#  - Any S3-compatible store:
# RESTIC_REPOSITORY=s3:https://s3.example.com/your-bucket
# AWS_ACCESS_KEY_ID=xxxx
# AWS_SECRET_ACCESS_KEY=xxxx

# The encryption password for the repo. LOSE THIS = LOSE THE BACKUP.
# Store a copy somewhere safe (password manager), not only on this server.
RESTIC_PASSWORD=change-me-to-a-long-random-passphrase

# Optional overrides (defaults shown):
# BACKUP_PATHS=/srv/appdata
# KEEP_DAILY=7
# KEEP_WEEKLY=4
# KEEP_MONTHLY=6
