# ─────────────────────────────────────────────────────────────
#  Copy this file to `.env` and fill in the values.
#  `cp .env.example .env`  then  `nano .env`
# ─────────────────────────────────────────────────────────────

# User/group the containers run as. Find yours with: `id`
PUID=1000
PGID=1000

# Your timezone. See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Amsterdam

# ── Paths on the HOST ────────────────────────────────────────
# Where each container keeps its config/database. Gets backed up.
CONFIG_ROOT=/srv/appdata

# Root of your media + downloads. Torrents and media MUST live on the
# same filesystem so the *arr apps can hardlink instead of copying.
#   ${DATA_ROOT}/torrents/{tv,movies,books}   <- qBittorrent downloads here
#   ${DATA_ROOT}/media/{tv,movies,books}      <- Jellyfin/Kavita read here
DATA_ROOT=/srv/data

# ── Download VPN (Gluetun) ───────────────────────────────────
# qBittorrent routes ALL traffic through this. Fill in your VPN provider.
# Full provider list: https://github.com/qdm12/gluetun-wiki
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=CHANGE_ME
WIREGUARD_ADDRESSES=10.64.0.2/32
# Optional: pin server location(s), e.g. Netherlands
SERVER_COUNTRIES=Netherlands

# ── Your LAN subnet (so qBittorrent's WebUI stays reachable) ──
# Adjust to match your home network (check your router).
LAN_SUBNET=192.168.1.0/24

# ── Samba share for Home Assistant backups ───────────────────
# HAOS writes its full backups here; restic then sweeps them off-site.
# Use a dedicated user/password (not your real login). LAN-only — keep
# port 445 firewalled to your LAN.
SMB_USER=habackup
SMB_PASSWORD=CHANGE_ME
